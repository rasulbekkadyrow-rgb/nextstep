# ==================================================================
# NEXT STEP CONSULTING — GURŞAW ÜÝTGEÝJILERI
# ------------------------------------------------------------------
# Bu faýl NUSGA. Ony göçürip alyň:
#     cp .env.example .env.local
# `.env.local` gitignore-da — ol hiç haçan repozitoriýa düşmeýär.
# ==================================================================


# ─── 1. GIRIŞ ULGAMY (hökmany) ────────────────────────────────────

# Seans kukisine gol çekilýän gizlin açar.
# Ol bolmasa islendik adam özüne «eýe» kukisini ýasap bilerdi.
# Döretmek:  openssl rand -base64 32
AUTH_SECRET=

# Dolandyryjylaryň esasy sanawy. Formaty:
#     salgy:rol:At  (rol we at islege görä; rol ýazylmasa — owner)
# Rollar:  owner (doly rugsat) · sales (arzalar) · analytics (seljerme)
#
# Şu ýerdäki ýazgylar panelden POZULMAÝAR — bular ätiýaçlyk açar:
# panelde ýalňyşlyk bilen hemme dolandyryjy pozulsa-da, giriş ýapylmaýar.
# Täze işgär bolsa panelden («Topar» bölüminden) goşulýar.
ADMIN_EMAILS="birinji@gmail.com:owner:Birinji Eýe, ikinji@gmail.com:owner:Ikinji Eýe"


# ─── 2. POÇTA — GIRIŞ KODY ŞU ÝERDEN IBERILÝÄR ────────────────────

# Sürüji: smtp | resend | console
#   · goýulmasa awtomatik saýlanýar (SMTP_HOST bar bolsa — smtp)
#   · console — hat iberilmeýär, kod terminalda çykýar (diňe synag)
MAIL_DRIVER=

# Hatyň iberijisi — alyjy şuny görýär
MAIL_FROM="Next Step Consulting <giris@nextstep.com.tm>"

# --- A görnüş: SMTP (islendik poçta hyzmaty) ---
# Gmail üçin: hasapda iki basgançakly barlag açylmaly, soňra
# «App password» döredilmeli — adaty parol bu ýerde işlemeýär.
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
# Yandex:     smtp.yandex.com  · 465 (SMTP_SECURE=true)
# Outlook:    smtp.office365.com · 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Boş goýulsa: 465 → true, galan ýagdaýda false
SMTP_SECURE=

# --- B görnüş: Resend (HTTP API, serwersiz gurşaw üçin) ---
RESEND_API_KEY=


# ─── 3. TELEGRAM BILDIRIŞLERI ─────────────────────────────────────

# @BotFather-den alynýan açar. Diňe serwerde galýar.
TELEGRAM_BOT_TOKEN=
# Kanalyň ýa toparyň ID belgisi (mysal: -1002xxxxxxxxx)
TELEGRAM_CHAT_ID=


# ─── 4. MAGLUMAT GORY (giriş ulgamy üçin) ─────────────────────────

# Ýerli kompýuterde we öz serweriňde (VPS) hiç zat gerek däl:
# maglumat `.data/` bukjasyndaky JSON faýllarda saklanýar.
#
# ⚠️ VERCEL-DE bu ÝARAMAÝAR — ol ýerde faýl ulgamy diňe okalýar.
# Şonuň üçin Vercel-de taslama KV gory birikdirilmeli:
#     Vercel → Storage → Upstash Redis → Connect Project
# Şondan soň bu iki üýtgeýji AWTOMATIK goşulýar:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Upstash-dan göni alynsa: UPSTASH_REDIS_REST_URL / _TOKEN hem işleýär)

# Bir gorda birnäçe taslama bolsa, açarlaryň öňündäki at
NS_KV_PREFIX=nextstep

# Faýl sürüjisinde maglumat saklanýan bukja (adaty ýagdaýda `.data`)
NS_DATA_DIR=
